<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/colorBackground</item>
    </style>

    <!-- Modern Splash Screen Theme -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Set the splash screen background, translucent is best for a seamless look -->
        <item name="windowSplashScreenBackground">@color/colorPrimary</item>
        <!-- Use your app logo -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/app_logo</item>
        <!-- Theme to use after the splash screen is gone -->
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>